# --- Required ---------------------------------------------------------------
# Postgres connection string. On Supabase: Project Settings > Database > Connection string
# (use the "Transaction pooler" URI, port 6543, for serverless hosting like Netlify).
DATABASE_URL=postgres://user:password@host:6543/postgres

# Random secret for signing admin sessions (32+ chars). Generate: openssl rand -base64 48
SESSION_SECRET=

# Public URL of the site, used in emails, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Email (optional until a provider is chosen) ----------------------------
# log    = record emails in Admin > Emails only (default; nothing is delivered)
# resend = deliver via Resend (https://resend.com)
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM="K444AXN Driving School <bookings@your-domain.co.uk>"

# --- Online payments (optional) ---------------------------------------------
# Leave blank to take payment at the lesson. When set, choose "Deposit" or
# "Full payment" in Admin > Settings.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
